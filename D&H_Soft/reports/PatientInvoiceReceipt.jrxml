	<queryString>
		<![CDATA[SELECT
*
FROM
    entry_path.patient_info pi
inner join entry_path.patient_advice pa on pi.receipt_id = pa.receipt_id
inner join entry_path.receipt_pay_total pay on pay.receipt_id = pa.receipt_id
left join entry_path.new_view_due p on pi.receipt_id = p.receipt_id
inner join entry_path.invoice inv on pi.receipt_id = inv.receipt_id
inner join entry_path.consultan_ref cons on pi.consultant_id = cons.cons_ref_id
where 
	inv.receipt_id = $P{id}]]>
	</queryString>
