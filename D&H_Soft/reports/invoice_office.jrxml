	</parameter>
	<queryString>
		<![CDATA[SELECT
  p.patient_code,
  p.name AS patient_name,
  p.age,
  p.gender,
  p.mobile,
  p.address,
  v.visit_code,
  v.visit_type,
  v.notes,
  v.visit_date,
  c1.name AS consultant_name,
  c2.name AS referred_by_name,
  ae.price_at_entry,
  ae.discount_amount,
  ae.final_price,
  tg.name AS test_group_name,
  ae.is_billed,
  ae.is_cancelled,
  ae.cancel_reason,
  ai.invoice_code,
  ai.gross_amount,
  ai.discount,
  ai.accessory_amount,
  ai.net_amount,
  ai.paid_amount,
  ai.is_paid,
  pay.payment_code,
  pay.total_amount,
  pay.paid_on,
  pay.remarks,
  u.username	
FROM diagnostics_patient p
JOIN diagnostics_patientvisit v ON v.patient_id = p.id
LEFT JOIN diagnostics_consultant c1 ON v.consultant_id = c1.id
LEFT JOIN diagnostics_consultant c2 ON v.referred_by_id = c2.id
LEFT JOIN diagnostics_adviceentry ae ON ae.visit_id = v.id
LEFT JOIN diagnostics_testgroup tg ON ae.group_id = tg.id
LEFT JOIN diagnostics_adviceinvoice ai ON ai.visit_id = v.id
LEFT JOIN diagnostics_payment pay ON pay.id = ( SELECT p1.id FROM diagnostics_payment p1 WHERE p1.invoice_id = ai.id AND p1.is_cancelled = 0 ORDER BY p1.paid_on DESC LIMIT 1 )
LEFT JOIN dh_soft_db.accounts_customuser u ON u.id = ai.created_by_id
WHERE v.visit_code = $P{visit_code}]]>
	</queryString>
