	<queryString>
		<![CDATA[SELECT ta.visit_code,a.name,ta.price_at_entry,ta.quantity, (ta.price_at_entry*ta.quantity) as total FROM dh_soft_db.diagnostics_testaccessoryentry ta
inner join dh_soft_db.diagnostics_testaccessory a on ta.accessory_id = a.id
WHERE ta.visit_code = $P{visit_code}]]>
	</queryString>
